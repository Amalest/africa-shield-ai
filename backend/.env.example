# Copy this file to .env and fill in real values (.env is gitignored, never commit it).
#
# Africa's Talking sandbox credentials — free to create at
# https://account.africastalking.com/. Sandbox apps default to username
# "sandbox"; the API key comes from your sandbox app's dashboard.
# Without these two set, POST /api/alerts/send still works but clearly
# labels every send as simulated instead of actually calling the SMS API.
AT_USERNAME=sandbox
AT_API_KEY=
# Optional. Leave unset to use the sandbox's default sender.
AT_SENDER_ID=
# Required only for voice alerts (POST /api/alerts/send with
# "channel": "voice"), not for SMS/USSD. Your sandbox app's Voice number,
# from the same dashboard (Voice > your virtual number).
AT_VOICE_NUMBER=

# Optional. Path to a Firebase service-account JSON file, for real push
# notifications to the mobile app. Free to create at
# https://console.firebase.google.com/ — Project Settings > Service
# Accounts > Generate new private key. Without this, push notifications
# are skipped/simulated the same way SMS is without AT_API_KEY. The
# mobile app also needs its own Firebase config — see
# mobile-app/lib/firebase_options.dart's doc comment.
FIREBASE_SERVICE_ACCOUNT_JSON=

# Signs/verifies admin Command Center session tokens (JWTs). Unlike the
# vars above, this can't "simulate" — the admin API always needs a secret
# to function at all. Falls back to a fixed, publicly-known demo value if
# left unset, so signup/login work out of the box for the hackathon demo
# — but that means anyone who reads this repo's source can forge a valid
# admin token. Set a real, random secret here before any real deployment
# (e.g. `python -c "import secrets; print(secrets.token_hex(32))"`).
ADMIN_JWT_SECRET=
