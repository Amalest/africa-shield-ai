# Copy this file to .env and fill in real values (.env is gitignored, never commit it).
#
# Africa's Talking sandbox credentials — free to create at
# https://account.africastalking.com/. Sandbox apps default to username
# "sandbox"; the API key comes from your sandbox app's dashboard.
# Without these two set, POST /api/alerts/send still works but clearly
# labels every send as simulated instead of actually calling the SMS API.
AT_USERNAME=sandbox
AT_API_KEY=
# Optional. Leave unset to use the sandbox's default sender.
AT_SENDER_ID=
# Required only for voice alerts (POST /api/alerts/send with
# "channel": "voice"), not for SMS/USSD. Your sandbox app's Voice number,
# from the same dashboard (Voice > your virtual number).
AT_VOICE_NUMBER=

# Optional. Path to a Firebase service-account JSON file, for real push
# notifications to the mobile app. Free to create at
# https://console.firebase.google.com/ — Project Settings > Service
# Accounts > Generate new private key. Without this, push notifications
# are skipped/simulated the same way SMS is without AT_API_KEY. The
# mobile app also needs its own Firebase config — see
# mobile-app/lib/firebase_options.dart's doc comment.
FIREBASE_SERVICE_ACCOUNT_JSON=

# Signs/verifies admin Command Center session tokens (JWTs). Unlike the
# vars above, this can't "simulate" — the admin API always needs a secret
# to function at all. If left unset, a random secret is generated for
# this process only (secure, but every admin session is invalidated on
# restart — see app/auth.py). Set a persistent one here to avoid that
# (e.g. `python -c "import secrets; print(secrets.token_hex(32))"`).
ADMIN_JWT_SECRET=

# Shared code required by POST /api/admin/signup — but only for creating
# the very first admin account on a fresh deployment; that route is
# permanently locked (403) the moment any admin exists. Every admin after
# that is created by an existing admin via POST /api/admin/admins, not
# through this code. Disabled entirely (503) until this is set. Give this
# value to teammates directly (Slack/etc.), never commit it.
ADMIN_SIGNUP_CODE=

# Optional HTTP Basic Auth for POST /api/ussd (Africa's Talking lets you
# embed user:pass@ directly in the webhook URL you configure in their
# dashboard). Without these set, the endpoint stays open — fine for the
# documented local curl-testing workflow, but set both before pointing a
# real USSD channel at a publicly reachable URL, or anyone on the
# internet can call it pretending to be any phone number.
USSD_WEBHOOK_USERNAME=
USSD_WEBHOOK_PASSWORD=

# Comma-separated list of allowed browser origins for CORS, e.g.
# "https://afrishield-dashboard.example.com,http://localhost:5173".
# Defaults to "*" (any origin) if unset — fine for local development,
# should be set to the dashboard's real URL(s) before a real deployment.
CORS_ALLOWED_ORIGINS=
